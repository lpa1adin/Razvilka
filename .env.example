# Скопируйте в .env и задайте свои пароли: cp .env.example .env
# Учётки создаются при первом запуске, если таких логинов ещё нет.
RZ_ADMIN_LOGIN=admin
RZ_ADMIN_PASSWORD=change-me-admin
RZ_USER_LOGIN=student
RZ_USER_PASSWORD=change-me-student

RZ_GRAFANA_PASSWORD=change-me-grafana

# Порты на этом компьютере
RZ_WEB_PORT=8660
RZ_GRAFANA_PORT=3060
RZ_PROMETHEUS_PORT=9090

# Этап 4: токен подписки Claude для agent-worker (`claude setup-token`). Не коммитить.
# CLAUDE_CODE_OAUTH_TOKEN=
